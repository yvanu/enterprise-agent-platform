APP_NAME=Enterprise Agent Platform
APP_ENV=development
# Demo tokens below are development-only. Production startup rejects these sample token keys.
AUTH_ENABLED=false
AUTH_TOKENS={"user-token":"alice:user","operator-token":"operator:operator","approver-token":"reviewer:approver","admin-token":"admin:admin"}
# Web console login. Change these outside demo environments.
CONSOLE_USERNAME=demo
CONSOLE_PASSWORD=demo
CONSOLE_ROLE=admin
SESSION_MAX_AGE_SECONDS=43200
RATE_LIMIT_PER_MINUTE=120
DATABASE_URL=sqlite:///./data/demo.db
DATABASE_SCHEMA=
# JSON map for extra read-only data sources, e.g. {"kingbase":{"url":"postgresql+psycopg://user:pass@host/db","schema":"public"}}
DATA_SOURCES={}
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=8

# Keep .env out of source control; inject real secrets through deployment environment/secret storage.
# Any OpenAI-compatible chat-completions endpoint can be used.
# Local endpoints without authentication are supported; leave LLM_API_KEY empty.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

KNOWLEDGE_DB_PATH=./data/knowledge.db
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760

# Comma-separated, read-only log files exposed to Ops Agent.
OPS_LOG_FILES=
PROMETHEUS_URL=
OPS_HTTP_TIMEOUT_SECONDS=5
OPS_ENABLE_DOCKER=false
OPS_ENABLE_KUBERNETES=false
# Comma-separated systemd services allowed for approved restart actions.
OPS_ALLOWED_SERVICES=
OPS_COMMAND_TIMEOUT_SECONDS=5

PLATFORM_DB_PATH=./data/platform.db
